{
  "redirects": [
    {
      "source": "/corridors",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/corridors/:slug",
      "destination": "/projects/:slug",
      "permanent": true
    },
    {
      "source": "/insights",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/insights/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
